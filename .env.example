# =====================================================================
# AI Chemistry Video Request Service - Environment Configuration
# =====================================================================

# [REQUIRED] Google Gemini API Key
# Enables the best-performance Gemini 3.5 Flash Lite engine to dynamically
# generate 4-scene explainer scripts with embedded LaTeX chemical equations.
# (Evaluators can use the provided review testing key from the submission email).
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Name (Default: gemini-3.5-flash-lite)
# Supported options: gemini-3.5-flash-lite, gemini-3-flash-preview, gemini-2.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Require Gemini LLM for script generation (Default: true)
REQUIRE_GEMINI=true

# Edge TTS Voice for Narration (Default: en-US-GuyNeural)
TTS_VOICE=en-US-GuyNeural

# Video Rendering Specifications
VIDEO_FPS=24
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080

# Worker Concurrency Settings
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=180
