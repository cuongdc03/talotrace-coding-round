# =====================================================================
# AI Chemistry Video Request Service - Environment Configuration
# =====================================================================

# Google Gemini API Key (Optional)
# If provided, chemistry scripts and LaTeX formulas are dynamically generated
# using Google Gemini 3.5 Flash Lite (gemini-3.5-flash-lite).
# If omitted or invalid, the service gracefully falls back to deterministic,
# guardrailed 30-second pedagogical templates with zero external dependencies.
GEMINI_API_KEY=

# LLM Model Name (Default: gemini-3.5-flash-lite)
# Supported options: gemini-3.5-flash-lite, gemini-3-flash-preview, gemini-2.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Edge TTS Voice for Narration (Default: en-US-GuyNeural)
TTS_VOICE=en-US-GuyNeural

# Video Rendering Specifications
VIDEO_FPS=24
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080

# Worker Concurrency Settings
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=180
